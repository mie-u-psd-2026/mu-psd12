# app.py: app.run() の引数（app.py:139）
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# services/database_service.py: STORAGE_DIR（既にos.environ.get対応済み）
STORAGE_DIR=/storage

# services/ai_service.py: OpenAI(base_url=..., api_key=...)（ai_service.py:8）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# services/ai_service.py: LLM_TIMEOUT（ai_service.py:11）
LLM_TIMEOUT=120
